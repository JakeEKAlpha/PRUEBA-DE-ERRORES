{
  "name": "lexmark-control",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "start:prod": "node scripts/start-production.mjs",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "build": "npm run build:client && npm run build:server",
    "preview": "vite preview",
    "clean": "node scripts/clean-generated.mjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test --experimental-test-isolation=none tests/*.test.ts",
    "verify:deploy": "tsx scripts/verify-deploy-readiness.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "docx-preview": "^0.4.1",
    "docxtemplater": "^3.71.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "pizzip": "^3.3.0",
    "puppeteer-core": "^25.17.0",
    "@sparticuz/chromium": "^141.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
