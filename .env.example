# Public URL where the app is hosted; used for allowed origins and self-referential links.
APP_URL="MY_APP_URL"

# Server runtime configuration
PORT="3000"
NODE_ENV="development"
DISABLE_HMR="true"

# DB_DRIVER: Database adapter driver for backend repositories ("memory" | "postgres").
DB_DRIVER="memory"

# PostgreSQL / Cloud SQL connection parameters (no secrets)
SQL_HOST=""
SQL_PORT="5432"
SQL_DB_NAME="postgres"
SQL_USER=""
SQL_PASSWORD=""
SQL_SSL="false"
SQL_CA_CERT=""

# Optional administrative credentials used exclusively by Drizzle CLI migrations (drizzle-kit)
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Supabase PostgreSQL alternatives (used when the corresponding SQL_* variables are empty)
SUPABASE_DB_HOST=""
SUPABASE_DB_PORT="5432"
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_USER="postgres"
SUPABASE_DB_PASSWORD=""
SUPABASE_DB_SSL="require"

# Optional Chromium/Puppeteer path override for containerized production (Cloud Run / Docker)
PUPPETEER_EXECUTABLE_PATH=""

